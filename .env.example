# Portas publicadas apenas no computador local.
FRONTEND_PORT=8081
BACKEND_PORT=8080

# OAuth Google Tasks. Ative com `docker compose -f compose.yaml -f compose.google.yaml up`.
HUB_GOOGLE_OAUTH_CLIENT_ID=
# Caminhos locais dos arquivos de segredo (fora do Git); usados pelo overlay Google.
HUB_GOOGLE_CLIENT_SECRET_FILE=./secrets/google-client-secret
HUB_GOOGLE_CREDENTIAL_KEY_FILE=./secrets/google-credential-key
